generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(cuid())
  name            String
  email           String           @unique
  password        String?
  image           String?
  role                    String           @default("USER") // "USER" or "ADMIN"
  isBanned                Boolean          @default(false)
  bannedAt                DateTime?
  banReason               String?
  invitedByUserId         String?
  subscriptions           String?          // JSON array of streaming provider names (e.g. ["Netflix", "Amazon Prime Video", "Disney Plus"])
  watchlistAlertsEnabled  Boolean          @default(true)
  lastSeenReleaseId       String?
  friendGroups            String?          // JSON array of friend groups (e.g. [{ id, name, emoji, memberNames }])
  mediaStatuses   MediaStatus[]
  recommendations Recommendation[]
  upvotes         RecommendationUpvote[]
  recommendationReplies RecommendationReply[]
  customCollections CustomCollection[]
  badges          UserBadge[]
  sentFriendships     Friendship[] @relation("UserSentFriendships")
  receivedFriendships Friendship[] @relation("UserReceivedFriendships")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Friendship {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("UserSentFriendships", fields: [userId], references: [id], onDelete: Cascade)
  friendId    String
  friend      User     @relation("UserReceivedFriendships", fields: [friendId], references: [id], onDelete: Cascade)
  status      String   @default("ACCEPTED") // "PENDING" | "ACCEPTED" | "DECLINED"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, friendId])
}

model WhitelistedEmail {
  id              String    @id @default(cuid())
  email           String    @unique
  invitedByUserId String?
  invitedByName   String?
  invitedByEmail  String?
  expiresAt       DateTime?
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([invitedByUserId, createdAt])
}

model InviteApprovalRequest {
  id               String    @id @default(cuid())
  targetEmail      String
  requesterUserId  String
  requesterName    String
  requesterEmail   String
  blockedReason    String
  status           String    @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@index([status, createdAt])
  @@index([requesterUserId, createdAt])
}

model MediaStatus {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tmdbId      Int
  mediaType   String   // "movie" | "tv"
  title       String
  posterPath  String?
  releaseYear String?
  status         String   // "WATCHED" | "WATCHLIST" | "WATCHING" (TV series only)
  rating         Int?     // 1-10 personal rating
  watchedSeasons String?   // JSON string: "[1, 2]"
  totalSeasons   Int?
  alertedAt      DateTime? // Timestamp when a watchlist streaming alert was last sent
  updatedAt      DateTime  @updatedAt
  createdAt   DateTime @default(now())

  @@unique([userId, tmdbId, mediaType])
}

model Recommendation {
  id             String                 @id @default(cuid())
  userId         String
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tmdbId         Int
  mediaType      String                 // "movie" | "tv"
  title          String
  posterPath     String?
  backdropPath   String?
  releaseYear    String?
  rating         Int                    // 1-10
  comment        String
  tags           String?                // Comma-separated tags e.g. "Must-Watch,Mindfuck"
  targetType     String?                // "ALL" | "GROUPS" | "FRIENDS" | "CUSTOM"
  targetNames    String?                // JSON string array e.g. '["@Familie", "Birgit Reinle"]'
  targetGroupIds String?                // JSON string array e.g. '["grp_123"]'
  targetUserIds  String?                // JSON string array e.g. '["usr_abc"]'
  upvotes        RecommendationUpvote[]
  replies        RecommendationReply[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
}

model RecommendationReply {
  id               String         @id @default(cuid())
  recommendationId String
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName         String
  userImage        String?
  text             String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model RecommendationUpvote {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendationId String
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@unique([userId, recommendationId])
}

model FriendGroup {
  id          String   @id @default(cuid())
  name        String
  emoji       String   @default("🛋️")
  ownerId     String
  ownerName   String?
  memberNames String   // JSON array of strings e.g. '["Lukas Reinle", "Birgit Reinle", "Ralf Reinle"]'
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CustomCollection {
  id             String   @id @default(cuid())
  ownerId        String
  owner          User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerName      String
  ownerImage     String?
  name           String
  tagline        String?
  description    String
  emoji          String   @default("🎬")
  posterPath     String?
  backdropPath   String?
  moviesJson     String   // JSON array of CollectionMovie items
  visibility     String   @default("PRIVATE") // "PRIVATE" | "FRIENDS" | "PUBLIC"
  approvalStatus String   @default("NONE")    // "NONE" | "PENDING" | "APPROVED" | "REJECTED"
  targetType     String?  @default("ALL")     // "ALL" | "CUSTOM"
  targetNames    String?  // JSON array of target friend/group names
  targetGroupIds String?  // JSON array of group IDs
  targetUserIds  String?  // JSON array of user IDs
  upvoterIds     String?  // JSON array of user IDs who liked the collection
  commentsJson   String?  // JSON array of comment objects
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model StreamingProviderSnapshot {
  id          String   @id @default(cuid())
  tmdbId      Int
  mediaType   String   // "movie" | "tv"
  providersDE String   @default("[]") // JSON array of normalized DE flatrate/free provider keys
  checkedAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tmdbId, mediaType])
}

model UserBadge {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeKey   String
  unlockedAt DateTime @default(now())

  @@unique([userId, badgeKey])
  @@index([userId, unlockedAt])
}
